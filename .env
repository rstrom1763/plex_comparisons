PLEX_DB_PATH="/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Plug-in Support/Databases/com.plexapp.plugins.library.db"
PORT=8080
PROTOCOL=https
PLEX_DATA_PATH="/var/lib/plexmediaserver/Library/Application Support/Plex Media Server"
LOG_FILE="/opt/plex_comparisons/plex_comparisons.log"

# Optional movie path mapping: Plex container prefix -> host OS prefix.
# Leave either value empty to disable. Include matching trailing separators.
PLEX_MOVIE_PATH_FROM=
PLEX_MOVIE_PATH_TO=
